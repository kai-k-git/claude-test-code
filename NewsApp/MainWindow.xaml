<Window x:Class="NewsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:NewsApp.ViewModels"
        xmlns:conv="clr-namespace:NewsApp.Converters"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="マイニュース" Height="780" Width="1100"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="DarkSidebarBrush"
            TrueValue="#FF1E1E2E"
            FalseValue="#FFF3F4F6"/>
        <conv:BoolToBrushConverter x:Key="DarkSidebarFg"
            TrueValue="#FFE0E0E0"
            FalseValue="#FF1A1A2E"/>
        <conv:BoolToBrushConverter x:Key="DarkContentBg"
            TrueValue="#FF13131F"
            FalseValue="#FFFAFAFA"/>
        <conv:BoolToBrushConverter x:Key="DarkCardBg"
            TrueValue="#FF1E1E2E"
            FalseValue="#FFFFFFFF"/>
        <conv:BoolToBrushConverter x:Key="DarkBorder"
            TrueValue="#FF2D2D42"
            FalseValue="#FFE5E7EB"/>
        <conv:BoolToBrushConverter x:Key="DarkSubtleFg"
            TrueValue="#FF9090A0"
            FalseValue="#FF6B7280"/>
        <conv:BoolToBrushConverter x:Key="DarkAccentBg"
            TrueValue="#FF2563EB"
            FalseValue="#FF2563EB"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====== Sidebar ====== -->
        <Border Grid.Column="0"
                Background="{Binding IsDark, Converter={StaticResource DarkSidebarBrush}}">
            <DockPanel>

                <!-- App Header -->
                <Border DockPanel.Dock="Top" Padding="16,20,16,12">
                    <StackPanel>
                        <TextBlock Text="📰 マイニュース"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{Binding IsDark, Converter={StaticResource DarkSidebarFg}}"/>
                        <TextBlock FontSize="11" Opacity="0.5" Margin="0,3,0,0"
                                   Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='更新: {0:MM/dd HH:mm}', Mode=OneTime}"
                                   xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                   Foreground="{Binding IsDark, Converter={StaticResource DarkSidebarFg}}"/>
                    </StackPanel>
                </Border>

                <!-- Separator -->
                <Separator DockPanel.Dock="Top" Margin="16,0" Opacity="0.2"/>

                <!-- Bottom Controls -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,12">
                    <!-- Refresh All -->
                    <Button Content="⟳  全カテゴリ更新"
                            Command="{Binding RefreshAllCommand}"
                            IsEnabled="{Binding IsRefreshingAll, Converter={StaticResource InvBool}}"
                            HorizontalAlignment="Stretch"
                            Height="38"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,0,8"/>

                    <!-- Dark Mode Toggle -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ダークモード"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{Binding IsDark, Converter={StaticResource DarkSidebarFg}}"/>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsOn="{Binding IsDark}"
                                         OffContent="" OnContent=""
                                         MinWidth="0" Margin="0"/>
                    </Grid>

                    <!-- Settings -->
                    <Button Content="⚙  設定"
                            HorizontalAlignment="Stretch"
                            Height="34"
                            Margin="0,8,0,0"
                            Click="OpenSettings_Click"/>
                </StackPanel>

                <!-- Separator -->
                <Separator DockPanel.Dock="Bottom" Margin="16,0" Opacity="0.2"/>

                <!-- Category List -->
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="8,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Category.Icon}"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category.Name}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding DataContext.IsDark,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource DarkSidebarFg}}"/>
                                    <TextBlock Text="{Binding LastUpdated}"
                                               FontSize="10" Opacity="0.5"
                                               Foreground="{Binding DataContext.IsDark,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource DarkSidebarFg}}"
                                               Visibility="{Binding LastUpdated,
                                                   Converter={StaticResource NullToVis}}"/>
                                </StackPanel>

                                <!-- Loading indicator -->
                                <ui:ProgressRing Grid.Column="2"
                                                 IsActive="{Binding IsLoading}"
                                                 Width="16" Height="16"
                                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                                <!-- Error dot -->
                                <Ellipse Grid.Column="2"
                                         Width="8" Height="8"
                                         Fill="#FFEF4444"
                                         Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ====== Main Content ====== -->
        <Grid Grid.Column="1"
              Background="{Binding IsDark, Converter={StaticResource DarkContentBg}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Content Header -->
            <Border Grid.Row="0" Padding="24,16"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{Binding IsDark, Converter={StaticResource DarkBorder}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding SelectedCategory, Converter={StaticResource NullToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedCategory.Category.Icon}"
                                       FontSize="24" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedCategory.Category.Name}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{Binding IsDark, Converter={StaticResource DarkSidebarFg}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedCategory.Category.Description}"
                                   FontSize="12" Opacity="0.6" Margin="0,4,0,0"
                                   Foreground="{Binding IsDark, Converter={StaticResource DarkSubtleFg}}"/>
                    </StackPanel>

                    <!-- Refresh button -->
                    <Button Grid.Column="1"
                            Height="36" Padding="16,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding SelectedCategory.LoadCommand}"
                            Visibility="{Binding SelectedCategory, Converter={StaticResource NullToVis}}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⟳" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="更新"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,20,24,24"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource NullToVis}}">
                <Grid>

                    <!-- Loading state -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,80"
                                Visibility="{Binding SelectedCategory.IsLoading, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsActive="True" Width="48" Height="48"
                                         HorizontalAlignment="Center"/>
                        <TextBlock Text="Claude が情報を収集しています..."
                                   FontSize="15" Opacity="0.7" Margin="0,16,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding IsDark, Converter={StaticResource DarkSubtleFg}}"/>
                        <TextBlock Text="Web検索を使用中。少しお待ちください。"
                                   FontSize="12" Opacity="0.5" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding IsDark, Converter={StaticResource DarkSubtleFg}}"/>
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,80"
                                Visibility="{Binding SelectedCategory.HasContent, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"
                                   Visibility="{Binding SelectedCategory.IsLoading, Converter={StaticResource InvBoolToVis}}">
                            📭
                        </TextBlock>
                        <TextBlock Text="「更新」ボタンを押して情報を取得してください"
                                   FontSize="15" Opacity="0.6"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding IsDark, Converter={StaticResource DarkSubtleFg}}"
                                   Visibility="{Binding SelectedCategory.IsLoading, Converter={StaticResource InvBoolToVis}}"/>
                    </StackPanel>

                    <!-- Error state -->
                    <Border CornerRadius="10"
                            Background="#FFFEF2F2"
                            BorderBrush="#FFFECACA"
                            BorderThickness="1"
                            Padding="20"
                            Visibility="{Binding SelectedCategory.HasError, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="⚠️ エラーが発生しました"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#FFDC2626" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SelectedCategory.ErrorMessage}"
                                       Foreground="#FF991B1B"
                                       TextWrapping="Wrap"/>
                            <TextBlock Margin="0,10,0,0" Opacity="0.7" FontSize="12"
                                       Foreground="#FF991B1B"
                                       Text="設定画面でAPIキーをご確認ください。"/>
                        </StackPanel>
                    </Border>

                    <!-- Content card -->
                    <Border x:Name="ContentCard"
                            CornerRadius="12"
                            Background="{Binding IsDark, Converter={StaticResource DarkCardBg}}"
                            BorderThickness="1"
                            BorderBrush="{Binding IsDark, Converter={StaticResource DarkBorder}}"
                            Padding="28,24"
                            Visibility="{Binding SelectedCategory.HasContent, Converter={StaticResource BoolToVis}}">
                        <RichTextBox x:Name="ContentViewer"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     IsDocumentEnabled="True"
                                     MinHeight="200"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"/>
                    </Border>

                </Grid>
            </ScrollViewer>

            <!-- No category selected -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding SelectedCategory, Converter={StaticResource NullToInvVis}}">
                <TextBlock Text="📰" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="左のカテゴリを選択してください"
                           FontSize="16" Opacity="0.5" Margin="0,16,0,0"
                           Foreground="{Binding IsDark, Converter={StaticResource DarkSubtleFg}}"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
